{
  "name": "playwright-smart-parallelization",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action for duration-balanced Playwright sharding.",
  "license": "MIT",
  "author": "Murat Kerem Ozcan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muratkeremozcan/playwright-smart-parallelization.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js qualification/lib/tests/*.test.js qualification/nsxbet/tests/unit/*.test.js qualification/flakiness/tests/unit/*.test.js measurements/tests/*.test.js",
    "check:public": "node scripts/check-public.js",
    "harness": "node harness/cli.js --cwd fixtures/consumer",
    "harness:negative": "node harness/cli.js --cwd fixtures/consumer --negative-control",
    "validate": "npm run lint && npm run format:check && npm run test && npm run check:public",
    "measurements:collect": "node measurements/collect.js --config measurements/couture-cast.json --out docs/measurements/raw",
    "measurements:report": "node measurements/render.js --raw docs/measurements/raw --out docs/measurements/baseline.md",
    "qualify:install": "npm ci --prefix fixtures/consumer && npm ci --prefix qualification/nsxbet && npm ci --prefix qualification/flakiness",
    "qualify:nsxbet": "node qualification/nsxbet/run.js",
    "qualify:nsxbet:test": "node --test --test-concurrency=1 qualification/nsxbet/tests/*.test.js",
    "qualify:flakiness": "node qualification/flakiness/run.js",
    "qualify:flakiness:test": "node --test --test-concurrency=1 qualification/flakiness/tests/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  }
}
