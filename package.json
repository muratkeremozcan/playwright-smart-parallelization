{
  "name": "playwright-smart-parallelization",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action for duration-balanced Playwright sharding: one step before your own Playwright command.",
  "license": "MIT",
  "author": "Murat Kerem Ozcan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muratkeremozcan/playwright-smart-parallelization.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix fixtures/consumer",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --require ./tests/support/temp.js --test tests/*.test.js",
    "check:public": "node scripts/check-public.js",
    "harness": "node harness/cli.js --cwd fixtures/consumer",
    "harness:negative": "node harness/cli.js --cwd fixtures/consumer --negative-control",
    "validate": "npm run lint && npm run format:check && npm run test && npm run check:public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@actions/artifact": "6.2.1",
    "@actions/cache": "6.3.0",
    "@actions/core": "3.0.1"
  }
}
